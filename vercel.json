{
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/predict", "dest": "api/main.py" },
    { "src": "/api/predict", "dest": "api/main.py" },
    { "src": "/style.css", "dest": "api/main.py" },
    { "src": "/app.js", "dest": "api/main.py" },
    { "src": "/modeler.js", "dest": "api/main.py" },
    { "src": "/electronegativitychart.jpg", "dest": "api/main.py" },
    { "src": "/(.*)", "dest": "api/main.py" }
  ]
}
